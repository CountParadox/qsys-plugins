-- Lunatone DALI-2 IoT gateway plugin for Q-SYS
-- Works with the Lunatone DALI-2 IoT / IoT4 gateway and devices that expose the same API
-- (e.g. a SmartCore running in DALI-2 IoT mode).
--
-- Commands: REST, POST /group/{n}/control and POST /broadcast/control with a ControlData body.
-- Feedback: the gateway WebSocket (ws://<ip>/) pushes "devices" events whenever a fitting changes.
-- Group state is derived from the fittings in that group: On if any fitting is on, Level = highest level.
-- If the WebSocket is down, the plugin polls GET /devices instead.
--
-- Do addressing, grouping and scene programming in DALI Cockpit or the gateway web UI.
-- This plugin only recalls groups and scenes.

PluginInfo = {
  Name = "Lunatone~DALI-2 IoT Gateway",
  Version = "0.1.0",
  BuildVersion = "0.1.0.0",
  Id = "c6c3e841-c15d-48ac-819f-670a8b422676",
  Author = "qsys-plugins",
  Description = "DALI group and scene control through a Lunatone DALI-2 IoT gateway",
}

function GetColor(props)
  return { 240, 170, 0 }
end

function GetPrettyName(props)
  return "Lunatone DALI-2 IoT\n" .. PluginInfo.Version
end

function GetProperties()
  return {
    { Name = "Group Rows", Type = "integer", Min = 1, Max = 16, Value = 4 },
    { Name = "Tunable White", Type = "boolean", Value = false },
    { Name = "Port", Type = "integer", Min = 1, Max = 65535, Value = 80 },
    { Name = "Debug", Type = "boolean", Value = false },
  }
end

function GetControls(props)
  local rows = props["Group Rows"].Value
  local tw = props["Tunable White"].Value
  local c = {
    { Name = "IPAddress", ControlType = "Text", UserPin = true, PinStyle = "Input", Count = 1 },
    { Name = "Status", ControlType = "Indicator", IndicatorType = "Status", UserPin = true, PinStyle = "Output", Count = 1 },
    { Name = "Online", ControlType = "Indicator", IndicatorType = "Led", UserPin = true, PinStyle = "Output", Count = 1 },
    { Name = "GatewayName", ControlType = "Indicator", IndicatorType = "Text", UserPin = false, Count = 1 },
    { Name = "Firmware", ControlType = "Indicator", IndicatorType = "Text", UserPin = false, Count = 1 },
    { Name = "DeviceCount", ControlType = "Indicator", IndicatorType = "Text", UserPin = false, Count = 1 },
    { Name = "AllOn", ControlType = "Button", ButtonType = "Trigger", UserPin = true, PinStyle = "Input", Count = 1 },
    { Name = "AllOff", ControlType = "Button", ButtonType = "Trigger", UserPin = true, PinStyle = "Input", Count = 1 },
    { Name = "Refresh", ControlType = "Button", ButtonType = "Trigger", UserPin = true, PinStyle = "Input", Count = 1 },
  }
  local function add(t) c[#c + 1] = t end
  for i = 1, rows do
    local p = "Group" .. i
    add({ Name = p .. "Address", ControlType = "Text", UserPin = false, Count = 1 })
    add({ Name = p .. "Members", ControlType = "Indicator", IndicatorType = "Text", UserPin = false, Count = 1 })
    add({ Name = p .. "On", ControlType = "Button", ButtonType = "Toggle", UserPin = true, PinStyle = "Both", Count = 1 })
    add({ Name = p .. "Level", ControlType = "Knob", ControlUnit = "Percent", Min = 0, Max = 100, UserPin = true, PinStyle = "Both", Count = 1 })
    add({ Name = p .. "Raise", ControlType = "Button", ButtonType = "Momentary", UserPin = true, PinStyle = "Input", Count = 1 })
    add({ Name = p .. "Lower", ControlType = "Button", ButtonType = "Momentary", UserPin = true, PinStyle = "Input", Count = 1 })
    add({ Name = p .. "Scene", ControlType = "Knob", ControlUnit = "Integer", Min = 0, Max = 15, UserPin = true, PinStyle = "Input", Count = 1 })
    add({ Name = p .. "Recall", ControlType = "Button", ButtonType = "Trigger", UserPin = true, PinStyle = "Input", Count = 1 })
    if tw then
      add({ Name = p .. "Kelvin", ControlType = "Knob", ControlUnit = "Integer", Min = 2700, Max = 6500, UserPin = true, PinStyle = "Both", Count = 1 })
    end
  end
  return c
end

function GetControlLayout(props)
  local rows = props["Group Rows"].Value
  local tw = props["Tunable White"].Value
  local layout, graphics = {}, {}
  local ROW = 22
  local y = 6
  local function text(t, x, w, align)
    graphics[#graphics + 1] = { Type = "Text", Text = t, HTextAlign = align or "Center", FontSize = 11,
      Position = { x, y }, Size = { w, ROW - 4 } }
  end
  local function ctl(name, pretty, x, w, style, legend)
    layout[name] = { PrettyName = pretty, Position = { x, y }, Size = { w, ROW - 4 }, Style = style, Legend = legend }
  end

  local width = tw and 640 or 570
  graphics[#graphics + 1] = { Type = "GroupBox", Text = "Gateway", Fill = { 242, 236, 224 }, StrokeWidth = 1,
    Position = { 4, y }, Size = { width, 26 + 4 * ROW } }
  y = y + 24
  text("IP Address", 10, 110, "Right"); ctl("IPAddress", "Setup~IP Address", 126, 150, "Text")
  ctl("Refresh", "Setup~Refresh", 284, 70, "Button", "Refresh"); y = y + ROW
  text("Status", 10, 110, "Right"); ctl("Status", "Status", 126, 228); ctl("Online", "Online", 362, 18); y = y + ROW
  text("Name / FW", 10, 110, "Right"); ctl("GatewayName", "Info~Name", 126, 110); ctl("Firmware", "Info~Firmware", 244, 110)
  ctl("DeviceCount", "Info~Fittings", 362, 70); y = y + ROW
  text("Broadcast", 10, 110, "Right"); ctl("AllOn", "Broadcast~All On", 126, 70, "Button", "All On")
  ctl("AllOff", "Broadcast~All Off", 202, 70, "Button", "All Off"); y = y + ROW + 10

  graphics[#graphics + 1] = { Type = "GroupBox", Text = "Groups", Fill = { 242, 236, 224 }, StrokeWidth = 1,
    Position = { 4, y }, Size = { width, 46 + rows * ROW } }
  y = y + 24
  text("Row", 8, 30); text("DALI grp", 40, 56); text("Fittings", 100, 56); text("On", 160, 40); text("Level", 204, 150)
  text("- / +", 358, 56); text("Scene", 418, 90); if tw then text("Kelvin", 512, 120) end
  y = y + ROW
  for i = 1, rows do
    local p, pn = "Group" .. i, "Group " .. i .. "~"
    text(tostring(i), 8, 30)
    ctl(p .. "Address", pn .. "DALI Group (0-15)", 46, 44, "Text")
    ctl(p .. "Members", pn .. "Fittings", 100, 56)
    ctl(p .. "On", pn .. "On", 160, 40, "Button")
    ctl(p .. "Level", pn .. "Level", 204, 150, "Fader")
    ctl(p .. "Lower", pn .. "Lower", 358, 26, "Button", "-")
    ctl(p .. "Raise", pn .. "Raise", 388, 26, "Button", "+")
    ctl(p .. "Scene", pn .. "Scene", 418, 40, "Text")
    ctl(p .. "Recall", pn .. "Recall Scene", 462, 46, "Button", "Recall")
    if tw then ctl(p .. "Kelvin", pn .. "Colour Temp (K)", 512, 120, "Fader") end
    y = y + ROW
  end
  return layout, graphics
end

if Controls then
  local rapidjson = require("rapidjson")

  local ROWS = Properties["Group Rows"].Value
  local TW = Properties["Tunable White"].Value
  local PORT = Properties["Port"].Value
  local DEBUG = Properties["Debug"].Value
  local RECONNECT_S, POLL_S, RAMP_S, RAMP_STEP = 5, 10, 0.25, 4

  local function dbg(...) if DEBUG then print("[DALI]", ...) end end
  local function isTable(v) return type(v) == "table" end
  local function ip() return (Controls.IPAddress.String or ""):match("^%s*(.-)%s*$") end
  local function base()
    local h = ip()
    if PORT ~= 80 then h = h .. ":" .. PORT end
    return "http://" .. h
  end

  DaliSocket = nil -- global: keep the socket alive for the garbage collector
  local wsUp = false
  local generation = 0
  local devices = {} -- id -> device table (merged from REST + WebSocket)
  local reconnectTimer, pollTimer = Timer.New(), Timer.New()

  local function setStatus(code, text)
    Controls.Status.Value = code
    Controls.Status.String = text or ""
    Controls.Online.Boolean = (code == 0)
  end

  local function groupNumber(i)
    local v = tonumber(Controls["Group" .. i .. "Address"].String)
    if v and v >= 0 and v <= 15 then return math.floor(v) end
    return nil
  end

  ---------------------------------------------------------------------------
  -- REST
  ---------------------------------------------------------------------------
  local function post(path, body, cb)
    if ip() == "" then return end
    dbg("POST", path, rapidjson.encode(body))
    HttpClient.Upload({
      Url = base() .. path,
      Method = "POST",
      Headers = { ["Content-Type"] = "application/json" },
      Data = rapidjson.encode(body),
      Timeout = 5,
      EventHandler = function(_, code, data, err)
        if code < 200 or code >= 300 then
          dbg("POST failed", path, code, err, data)
          setStatus(1, "Command failed (" .. tostring(code) .. ") " .. path)
        end
        if cb then cb(code, data) end
      end,
    })
  end

  local function get(path, cb)
    if ip() == "" then return end
    HttpClient.Download({
      Url = base() .. path,
      Timeout = 5,
      EventHandler = function(_, code, data, err)
        if code == 200 and data then
          local ok, obj = pcall(rapidjson.decode, data)
          if ok then cb(obj) return end
        end
        dbg("GET failed", path, code, err)
        cb(nil, code, err)
      end,
    })
  end

  ---------------------------------------------------------------------------
  -- State
  ---------------------------------------------------------------------------
  local levelHold = {} -- rows whose fader is being moved; ignore feedback for a moment

  local function merge(dst, src)
    for k, v in pairs(src) do
      if isTable(v) and isTable(dst[k]) and #v == 0 and next(v) ~= nil then
        merge(dst[k], v)
      else
        dst[k] = v
      end
    end
  end

  local function featureStatus(d, name)
    local f = isTable(d.features) and d.features[name]
    if isTable(f) then return f.status end
    return nil
  end

  local function inGroup(d, g)
    if not isTable(d.groups) then return false end
    for _, x in ipairs(d.groups) do if x == g then return true end end
    return false
  end

  function RecomputeGroups()
    local total = 0
    for _ in pairs(devices) do total = total + 1 end
    Controls.DeviceCount.String = tostring(total)
    for i = 1, ROWS do
      local g = groupNumber(i)
      local p = "Group" .. i
      if g == nil then
        Controls[p .. "Members"].String = "-"
      else
        local count, on, level, kelvin = 0, false, 0, nil
        for _, d in pairs(devices) do
          if inGroup(d, g) then
            count = count + 1
            local sw = featureStatus(d, "switchable")
            local lv = featureStatus(d, "dimmable")
            if sw == true then on = true end
            if type(lv) == "number" and lv > level then level = lv end
            local k = featureStatus(d, "colorKelvin")
            if type(k) == "number" then kelvin = k end
          end
        end
        Controls[p .. "Members"].String = tostring(count)
        Controls[p .. "On"].Boolean = on
        if not levelHold[i] then
          Controls[p .. "Level"].Value = on and level or 0
          if TW and kelvin then Controls[p .. "Kelvin"].Value = kelvin end
        end
      end
    end
  end

  function LoadDevices(list)
    if not isTable(list) then return end
    devices = {}
    for _, d in ipairs(list) do
      if isTable(d) and d.id ~= nil then devices[d.id] = d end
    end
    RecomputeGroups()
  end

  function UpdateDevices(list)
    if not isTable(list) then return end
    for _, d in ipairs(list) do
      if isTable(d) and d.id ~= nil then
        if devices[d.id] then merge(devices[d.id], d) else devices[d.id] = d end
      end
    end
    RecomputeGroups()
  end

  local function fetchAll()
    get("/info", function(info)
      if isTable(info) then
        Controls.GatewayName.String = tostring(info.name or "")
        Controls.Firmware.String = tostring(info.version or "")
      end
    end)
    get("/devices", function(obj, code, err)
      if isTable(obj) and isTable(obj.devices) then
        LoadDevices(obj.devices)
        if wsUp then setStatus(0, "") else setStatus(1, "Polling (WebSocket down)") end
      else
        setStatus(2, "Gateway not responding (" .. tostring(code or err) .. ")")
      end
    end)
  end

  ---------------------------------------------------------------------------
  -- WebSocket
  ---------------------------------------------------------------------------
  local function dropSocket()
    wsUp = false
    local s = DaliSocket
    DaliSocket = nil
    generation = generation + 1
    if s then pcall(function() s:Close() end) end
  end

  function Connect()
    reconnectTimer:Stop()
    dropSocket()
    if ip() == "" then
      setStatus(3, "Enter the gateway IP address")
      return
    end
    setStatus(5, "Connecting to " .. ip())
    local gen = generation
    local s = WebSocket.New()
    DaliSocket = s
    s.Connected = function()
      if gen ~= generation then return end
      wsUp = true
      dbg("websocket connected")
      -- We do not need raw bus traffic.
      s:Write(rapidjson.encode({ type = "filtering", data = { daliMonitor = true } }), false)
      fetchAll()
    end
    s.Data = function(_, data)
      if gen ~= generation then return end
      local ok, msg = pcall(rapidjson.decode, data)
      if not ok or not isTable(msg) then return end
      if msg.type == "devices" and isTable(msg.data) then
        UpdateDevices(msg.data.devices)
      elseif msg.type == "devicesDeleted" then
        fetchAll()
      elseif msg.type == "info" and isTable(msg.data) then
        Controls.GatewayName.String = tostring(msg.data.name or "")
        Controls.Firmware.String = tostring(msg.data.version or "")
      end
    end
    local function lost(why)
      if gen ~= generation then return end
      dbg("websocket lost:", why)
      dropSocket()
      setStatus(1, "WebSocket " .. why .. ", polling")
      reconnectTimer:Start(RECONNECT_S)
    end
    s.Error = function(_, err) lost("error: " .. tostring(err)) end
    s.Closed = function() lost("closed") end
    s:Connect("ws", ip(), "/", PORT)
  end

  reconnectTimer.EventHandler = function() reconnectTimer:Stop(); Connect() end

  -- Poll while the WebSocket is down; ping it while it is up.
  pollTimer.EventHandler = function()
    if wsUp and DaliSocket then
      pcall(function() DaliSocket:Ping() end)
    else
      fetchAll()
    end
  end
  pollTimer:Start(POLL_S)

  ---------------------------------------------------------------------------
  -- Controls
  ---------------------------------------------------------------------------
  local function control(i, body)
    local g = groupNumber(i)
    if g == nil then
      setStatus(1, "Group row " .. i .. " has no DALI group number")
      return
    end
    post("/group/" .. g .. "/control", body)
  end

  local throttles = {}
  local function throttled(i, send)
    local t = throttles[i]
    if not t then
      t = { timer = Timer.New(), release = Timer.New(), busy = false }
      t.timer.EventHandler = function()
        t.timer:Stop()
        if t.pending then local f = t.pending; t.pending = nil; f(); t.timer:Start(0.2) else t.busy = false end
      end
      t.release.EventHandler = function() t.release:Stop(); levelHold[i] = nil end
      throttles[i] = t
    end
    levelHold[i] = true
    t.release:Stop(); t.release:Start(2)
    if t.busy then t.pending = send else t.busy = true; send(); t.timer:Start(0.2) end
  end

  for i = 1, ROWS do
    local p = "Group" .. i
    if Controls[p .. "Address"].String == "" then Controls[p .. "Address"].String = tostring(i - 1) end
    Controls[p .. "Address"].EventHandler = function() RecomputeGroups() end

    Controls[p .. "On"].EventHandler = function(c)
      control(i, { switchable = c.Boolean })
    end

    Controls[p .. "Level"].EventHandler = function(c)
      Controls[p .. "On"].Boolean = c.Value > 0
      throttled(i, function()
        control(i, { dimmable = math.floor(Controls[p .. "Level"].Value + 0.5) })
      end)
    end

    -- Raise / Lower: step the level while held.
    local ramp = Timer.New()
    local dir = 0
    ramp.EventHandler = function()
      local lvl = Controls[p .. "Level"].Value + dir * RAMP_STEP
      if lvl < 1 then lvl = 1 end
      if lvl > 100 then lvl = 100 end
      Controls[p .. "Level"].Value = lvl
      Controls[p .. "On"].Boolean = true
      throttled(i, function() control(i, { dimmable = math.floor(lvl + 0.5) }) end)
    end
    local function rampButton(c, d)
      if c.Boolean then dir = d; ramp.EventHandler(); ramp:Start(RAMP_S) else ramp:Stop() end
    end
    Controls[p .. "Raise"].EventHandler = function(c) rampButton(c, 1) end
    Controls[p .. "Lower"].EventHandler = function(c) rampButton(c, -1) end

    Controls[p .. "Recall"].EventHandler = function()
      control(i, { scene = math.floor(Controls[p .. "Scene"].Value) })
    end

    if TW then
      Controls[p .. "Kelvin"].EventHandler = function(c)
        throttled(i, function()
          control(i, { colorKelvin = math.floor(Controls[p .. "Kelvin"].Value) })
        end)
      end
    end
  end

  Controls.AllOn.EventHandler = function() post("/broadcast/control", { switchable = true }) end
  Controls.AllOff.EventHandler = function() post("/broadcast/control", { switchable = false }) end
  Controls.Refresh.EventHandler = function() fetchAll() end
  Controls.IPAddress.EventHandler = function() Connect() end

  Connect()
end
